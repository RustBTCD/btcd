{
  "rpc": "chain.headers_after",
  "description": "Headers to serve a peer's getheaders from the active chain, as Core does: those following the first locator hash that is on the active chain, or genesis if none is.",
  "operator": false,
  "request": {
    "type": "object",
    "additionalProperties": false,
    "required": ["locator"],
    "properties": {
      "locator": {
        "type": "array",
        "maxItems": 101,
        "items": {"$ref": "../../../../schemas/common.json#/$defs/Hash"},
        "description": "An empty locator returns only the stop header, if known."
      },
      "stop": {"$ref": "../../../../schemas/common.json#/$defs/Hash", "description": "Stop after this header."},
      "max": {"type": "integer", "minimum": 1, "maximum": 2000, "default": 2000, "description": "Maximum headers."}
    }
  },
  "response": {
    "type": "object",
    "additionalProperties": false,
    "required": ["headers"],
    "properties": {
      "headers": {"type": "array", "maxItems": 2000, "items": {"$ref": "../../../../schemas/common.json#/$defs/HeaderHex"}}
    }
  },
  "examples": [
    {
      "request": {"locator": ["000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f"]},
      "response": {
        "headers": [
          "010000006fe28c0ab6f1b372c1a6a246ae63f74f931e8365e15a089c68d6190000000000982051fd1e4ba744bbbe680e1fee14677ba1a3c3540bf7b1cdb606e857233e0e61bc6649ffff001d01e36299"
        ]
      }
    }
  ]
}
