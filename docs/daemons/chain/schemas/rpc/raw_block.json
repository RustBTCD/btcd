{
  "rpc": "chain.raw_block",
  "description": "A stored block in consensus encoding. block-sync uses it to serve getdata.",
  "operator": true,
  "request": {
    "type": "object",
    "additionalProperties": false,
    "required": ["block"],
    "properties": {"block": {"$ref": "../../../../schemas/common.json#/$defs/BlockId"}}
  },
  "response": {
    "type": "object",
    "additionalProperties": false,
    "required": ["hash", "height", "in_active_chain", "hex"],
    "properties": {
      "hash": {"$ref": "../../../../schemas/common.json#/$defs/Hash"},
      "height": {"$ref": "../../../../schemas/common.json#/$defs/Height"},
      "in_active_chain": {"type": "boolean"},
      "hex": {"$ref": "../../../../schemas/common.json#/$defs/BlockHex"}
    }
  },
  "examples": [
    {
      "request": {"block": "1"},
      "response": {
        "hash": "00000000839a8e6886ab5951d76f411475428afc90947ee320161bbf18eb6048",
        "height": 1,
        "in_active_chain": true,
        "hex": ""
      }
    }
  ]
}
