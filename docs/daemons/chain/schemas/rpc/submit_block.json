{
  "rpc": "chain.submit_block",
  "description": "Validate, store and possibly connect a block.",
  "operator": false,
  "request": {
    "type": "object",
    "additionalProperties": false,
    "required": ["block", "requested"],
    "properties": {
      "block": {"$ref": "../../../../schemas/common.json#/$defs/BlockHex"},
      "requested": {"type": "boolean", "description": "Whether block-sync asked for this block."},
      "peer": {"$ref": "../../../../schemas/common.json#/$defs/PeerId", "description": "The sending peer, for logs."}
    }
  },
  "response": {
    "type": "object",
    "additionalProperties": false,
    "required": ["status", "hash", "tip"],
    "properties": {
      "status": {
        "type": "string",
        "enum": ["connected", "stored", "duplicate", "unconnected", "ignored"],
        "description": "connected: stored and now on the active chain. stored: stored, not (yet) on the active chain. duplicate: already stored. unconnected: the parent header is unknown. ignored: unrequested and not useful."
      },
      "hash": {"$ref": "../../../../schemas/common.json#/$defs/Hash", "description": "The submitted block."},
      "tip": {"$ref": "../../../../schemas/common.json#/$defs/BlockRef", "description": "The active tip after the call."}
    }
  },
  "examples": [
    {
      "request": {
        "block": "",
        "requested": true,
        "peer": 7
      },
      "response": {
        "status": "connected",
        "hash": "00000000839a8e6886ab5951d76f411475428afc90947ee320161bbf18eb6048",
        "tip": {"hash": "00000000839a8e6886ab5951d76f411475428afc90947ee320161bbf18eb6048", "height": 1}
      }
    }
  ]
}
