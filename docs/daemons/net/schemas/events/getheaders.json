{
  "event": "net.getheaders",
  "description": "A getheaders message.",
  "payload": {
    "type": "object",
    "additionalProperties": false,
    "required": ["peer", "locator", "stop"],
    "properties": {
      "peer": {"$ref": "../../../../schemas/common.json#/$defs/PeerId", "description": "The peer."},
      "locator": {
        "type": "array",
        "maxItems": 101,
        "items": {"$ref": "../../../../schemas/common.json#/$defs/Hash"},
        "description": "At most 101 hashes, as Core's MAX_LOCATOR_SZ."
      },
      "stop": {
        "oneOf": [{"$ref": "../../../../schemas/common.json#/$defs/Hash"}, {"type": "null"}],
        "description": "null when the message has an all-zero stop hash."
      }
    }
  },
  "examples": [
    {
