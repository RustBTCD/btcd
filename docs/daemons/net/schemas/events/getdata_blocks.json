{
  "event": "net.getdata_blocks",
  "description": "The block items of a getdata message.",
  "payload": {
    "type": "object",
    "additionalProperties": false,
    "required": ["peer", "items"],
    "properties": {
      "peer": {"$ref": "../../../../schemas/common.json#/$defs/PeerId", "description": "The peer."},
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 50000,
        "items": {"$ref": "../types.json#/$defs/InvItem"}
      }
    }
  },
  "examples": [
    {
      "peer": 7,
      "items": [
        {
          "type": "witness_block",
          "hash": "00000000839a8e6886ab5951d76f411475428afc90947ee320161bbf18eb6048"
        }
      ]
    }
  ]
}
